# PIXE: 3 MeV proton beam on the same pellet (range ~0.1 mm, so thickness is irrelevant).
# Note: real PIXE on Ca-rich matrices uses an absorber (e.g. Mylar) to tame Ca K lines.
/control/verbose 1
/run/numberOfThreads 8

/xrf/sample/matrix phosphate
/xrf/sample/density 2.0 g/cm3
/xrf/sample/thickness 1 mm
/xrf/sample/clearTraces
/xrf/sample/ppm U 120
/xrf/sample/ppm Th 10
/xrf/sample/ppm Cd 30
/xrf/sample/ppm Sr 1000

/run/initialize
/gps/particle proton
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/centre 0 0 -50 mm
/gps/pos/radius 1 mm
/gps/direction 0 0 1
/gps/ene/type Mono
/gps/ene/mono 3 MeV

/analysis/setFileName out/pixe_phosphate
/run/printProgress 100000
/run/beamOn 2000000
