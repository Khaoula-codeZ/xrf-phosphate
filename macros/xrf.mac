# Single XRF spectrum of phosphate rock with representative traces.
/control/verbose 1
/run/verbose 1
/run/numberOfThreads 8

/xrf/sample/matrix phosphate
/xrf/sample/density 2.0 g/cm3
/xrf/sample/thickness 5 mm
/xrf/sample/clearTraces
/xrf/sample/ppm U 106
/xrf/sample/ppm Cd 16

/run/initialize
/control/execute macros/source_xrf.mac

/analysis/setFileName out/xrf_phosphate
/run/printProgress 10000000
/run/beamOn 100000000
